@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {

Class TuitionBookParser
Class "XYZCommand\n<<representative>>" as XYZCommand
Class CommandResult
Class "{abstract}\nCommand" as Command


Class "<<interface>>\nLogic" as Logic
Class LogicManager
}

Class "<<interface>>\nModel" as Model MODEL_COLOR
Class "<<interface>>\nStorage" as Storage STORAGE_COLOR

Class HiddenOutside #FFFFFF
HiddenOutside ..> Logic

LogicManager .right.|> Logic
LogicManager --> "1" TuitionBookParser
TuitionBookParser ..> XYZCommand : <<create>>

XYZCommand -up-|> Command
LogicManager .left.> Command : <<call>>

LogicManager --> Model
LogicManager --> Storage
Command .right.> Model
Command .right.> Storage
note as RepresentativeCommandNote
XYZCommand represents a concrete command,
such as AddCommand or FindCommand.
end note
' Keep the note connector dashed, using the same layout technique as UiClassDiagram.
' Source: https://forum.plantuml.net/20309/comments-notation-plantuml-according-standard-specification
XYZCommand -[hidden]left- RepresentativeCommandNote
XYZCommand .. RepresentativeCommandNote

Logic ..> CommandResult
Command .up.> CommandResult : <<create>>

TuitionBookParser -[hidden]right- LogicManager
LogicManager -[hidden]right- Command
Command -[hidden]down- Model
Model -[hidden]right- Storage
@enduml
