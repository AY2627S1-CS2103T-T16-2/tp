@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyTuitionBook" as ReadOnlyTuitionBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class TuitionBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class "<<enumeration>>\nRole" as Role
Class Address
Class Email
Class Name
Class Phone
Class Tag

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

TuitionBook .up.|> ReadOnlyTuitionBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyTuitionBook
ModelManager -left-> "1" TuitionBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

TuitionBook *--> "1" UniquePersonList
UniquePersonList --> "~* all" Person
Person ---> "1" Role
Person *---> "1" Name
Person *---> "1" Phone
Person *---> "0..1" Email
Person *---> "0..1" Address
Person *---> "*" Tag
Person "*" --> "0..1 guardian" Person

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Role -[hidden]right-> Name
Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

ModelManager --> "~* filtered" Person

legend bottom
  Every Person has an internal UUID id. A student's guardian link is
  stored as the guardian's id in its guardianId field. Only a student
  may link a guardian, the target must have the guardian role, and
  one guardian may be linked by many students.
end legend
@enduml
