@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedTuitionBook" as VersionedTuitionBook MODEL_COLOR
end box

[-> Model : undoTuitionBook()
activate Model

Model -> VersionedTuitionBook : undo()
activate VersionedTuitionBook

VersionedTuitionBook -> VersionedTuitionBook :resetData(ReadOnlyTuitionBook)
VersionedTuitionBook --> Model :
deactivate VersionedTuitionBook

[<-- Model
deactivate Model

@enduml
