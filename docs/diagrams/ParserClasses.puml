@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package "Commands (partial)" {
abstract class Command
class AddCommand
abstract class TagModificationCommand
class TagCommand
}

package "Parser classes (partial)" {
interface "Parser<T>" as Parser
class TuitionBookParser
class AddCommandParser
class TagCommandParser
class TagModificationCommandParser
class CliSyntax
class ParserUtil
class ArgumentMultimap
class ArgumentTokenizer
class Prefix
}

TuitionBookParser .down.> AddCommandParser : <<create>>
TuitionBookParser .down.> TagCommandParser : <<create>>
TuitionBookParser ..> Command : returns

AddCommandParser .up.|> Parser
TagCommandParser .up.|> Parser

AddCommandParser ..> AddCommand : <<create>>
TagCommandParser ..> TagCommand : constructor reference
AddCommand -up-|> Command
TagModificationCommand -up-|> Command
TagCommand -up-|> TagModificationCommand

TagCommandParser ..> TagModificationCommandParser : calls parse

AddCommandParser ..> ArgumentMultimap
AddCommandParser ..> ArgumentTokenizer
AddCommandParser ..> CliSyntax
AddCommandParser ..> ParserUtil
TagModificationCommandParser ..> ArgumentMultimap
TagModificationCommandParser ..> ArgumentTokenizer
TagModificationCommandParser ..> CliSyntax
TagModificationCommandParser ..> ParserUtil

ArgumentTokenizer ..> ArgumentMultimap : <<create>>
ArgumentTokenizer ..> Prefix
ArgumentMultimap --> "*" Prefix : keys
CliSyntax --> "*" Prefix : constants

note bottom of TagModificationCommandParser
  Package-private helper; does not implement Parser.
  Invokes the supplied command constructor after parsing.
  UntagCommandParser also delegates to this helper
  with the UntagCommand constructor (not shown).
end note

note top of TuitionBookParser
  Other command parsers omitted.
  Creates HelpCommand, ExitCommand and
  ReloadCommand directly (not shown).
end note
@enduml
