@startuml
!include style.puml
skinparam ArrowFontStyle plain

title Successful execution of delete 1

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":TuitionBookParser" as TuitionBookParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant "s:Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("delete 1")
activate LogicManager

LogicManager -> TuitionBookParser : parseCommand("delete 1")
activate TuitionBookParser

create DeleteCommandParser
TuitionBookParser -> DeleteCommandParser : DeleteCommandParser()
activate DeleteCommandParser
DeleteCommandParser --> TuitionBookParser
deactivate DeleteCommandParser

TuitionBookParser -> DeleteCommandParser : parse(" 1")
activate DeleteCommandParser

note over DeleteCommandParser
Parse the argument into an Index
with one-based value 1.
end note

create DeleteCommand
DeleteCommandParser -> DeleteCommand : DeleteCommand(index)
activate DeleteCommand
DeleteCommand --> DeleteCommandParser
deactivate DeleteCommand

DeleteCommandParser --> TuitionBookParser : d
deactivate DeleteCommandParser

TuitionBookParser --> LogicManager : d
deactivate TuitionBookParser

LogicManager -> DeleteCommand : canMutate()
activate DeleteCommand
DeleteCommand --> LogicManager : true
deactivate DeleteCommand

note over LogicManager
Before execution, copy the current TuitionBook
and retain the active filter for rollback.
Snapshot interactions are omitted.
end note

LogicManager -> DeleteCommand : execute(m, s)
activate DeleteCommand

note over DeleteCommand
The inherited execute(Model, Storage)
delegates to execute(Model).
end note

DeleteCommand -> Model : getFilteredPersonList()
activate Model
Model --> DeleteCommand : lastShownList
deactivate Model

note over DeleteCommand
Validate the displayed index.
Resolve personToDelete = lastShownList.get(0).

Identify affected students from the full
contact list for the feedback message.
These lookup interactions are omitted.
end note

DeleteCommand -> Model : deletePerson(personToDelete)
activate Model

note right of Model
Deleting a guardian also clears
the guardian links of linked students.
Model internals are omitted.
end note

Model --> DeleteCommand
deactivate Model

note over DeleteCommand
Set requiresSave to true.
Build the success message, including
affected students where applicable.
end note

create CommandResult
DeleteCommand -> CommandResult : CommandResult(successMessage)
activate CommandResult
CommandResult --> DeleteCommand
deactivate CommandResult

DeleteCommand --> LogicManager : r
deactivate DeleteCommand

LogicManager -> DeleteCommand : requiresSave()
activate DeleteCommand
DeleteCommand --> LogicManager : true
deactivate DeleteCommand

opt command requires saving
    LogicManager -> Model : getTuitionBook()
    activate Model
    Model --> LogicManager : tuitionBook
    deactivate Model

    LogicManager -> Storage : saveTuitionBook(tuitionBook)
    activate Storage
    Storage --> LogicManager
    deactivate Storage
end

note over LogicManager, Storage
The successful save path is shown.
If saving fails with an IOException,
LogicManager restores the contacts and filter,
then throws a CommandException.
end note

[<-- LogicManager : r
deactivate LogicManager

@enduml
