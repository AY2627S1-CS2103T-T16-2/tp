@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Class "<<enumeration>>\nRole" as Role

TuitionBook *-right-> "1" UniquePersonList
TuitionBook *-right-> "1" UniqueTagList
UniqueTagList -[hidden]down- UniquePersonList

UniqueTagList -right-> "*" Tag
UniquePersonList -right-> "*" Person

Person -up-> "*" Tag
Person "*" --> "0..1 guardian" Person

Person ---> "1" Role
Person *---> "1" Name
Person *---> "1" Phone
Person *---> "0..1" Email
Person *---> "0..1" Address

legend bottom
  The guardian link is stored as the guardian's
  UUID id (guardianId), not as a direct Person reference.
end legend
@enduml
