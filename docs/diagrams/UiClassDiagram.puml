@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam ClassFontSize 17
skinparam PackageFontSize 16
skinparam ArrowFontSize 12
skinparam ArrowFontStyle plain
skinparam nodesep 15
skinparam ranksep 20
skinparam padding 10
scale max 800 width
allowmixing

package UI {
    interface Ui
    class UiManager
    class MainWindow
    class StartupNotice
}

package "Logic" as LogicPackage {
    interface "Logic" as LogicApi <<interface>> #3333C4
}

class MainApp #555555

MainApp --> "1" Ui : starts
UiManager .up.|> Ui
UiManager --> "0..1" MainWindow
UiManager --> "0..1" StartupNotice : displays at startup
UiManager -right-> "1" LogicApi

MainWindow -up-> "1" LogicApi : commands and lists

note as UiPartsNote
MainWindow's UI parts are expanded
in the following diagram.
end note
' Keep PlantUML from merging the single note link into a speech-bubble attachment.
' Layout technique adapted from https://forum.plantuml.net/20309/comments-notation-plantuml-according-standard-specification
MainWindow -[hidden]down- UiPartsNote
MainWindow .. UiPartsNote
@enduml
