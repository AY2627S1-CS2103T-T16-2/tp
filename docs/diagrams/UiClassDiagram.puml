@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam ClassFontSize 17
skinparam PackageFontSize 16
skinparam ArrowFontSize 12
skinparam ArrowFontStyle plain
skinparam nodesep 15
skinparam ranksep 20
scale max 800 width
allowmixing

package UI {
    interface Ui
    class UiManager
    class MainWindow
    class StartupNotice
    package "UI parts" as UiParts
}

package Logic {
    interface Logic #3333C4
}

class MainApp #555555

MainApp --> "1" Ui : starts
UiManager .up.|> Ui
UiManager --> "0..1" MainWindow
UiManager --> "0..1" StartupNotice : displays at startup
UiManager --> "1" Logic

MainWindow --> UiParts : contains UI parts
MainWindow ..> Logic : commands and lists

note right of UiParts
Detailed UI-part relationships
are shown in the UI parts diagram.
end note
@enduml
