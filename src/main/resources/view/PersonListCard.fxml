<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.Double?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="5" right="5" bottom="5" left="15" />
  </padding>
  <HBox spacing="8" alignment="CENTER_LEFT">
    <Label fx:id="id" styleClass="cell_big_label">
      <minWidth>
        <!-- Ensures that the label text is never truncated -->
        <Region fx:constant="USE_PREF_SIZE" />
      </minWidth>
    </Label>
    <Label fx:id="name" text="\$first" styleClass="cell_big_label" minWidth="0.0" HBox.hgrow="ALWAYS">
      <maxWidth>
        <Double fx:constant="MAX_VALUE" />
      </maxWidth>
    </Label>
    <Label fx:id="role" styleClass="role_badge">
      <minWidth>
        <Region fx:constant="USE_PREF_SIZE" />
      </minWidth>
    </Label>
  </HBox>
  <Label fx:id="queryNotice" styleClass="cell_small_label" wrapText="true" maxWidth="Infinity" />
  <FlowPane fx:id="tags" minWidth="0.0" prefWrapLength="1.0">
    <maxWidth>
      <Double fx:constant="MAX_VALUE" />
    </maxWidth>
  </FlowPane>
  <Label fx:id="phone" styleClass="cell_small_label" text="\$phone">
    <maxWidth>
      <Double fx:constant="MAX_VALUE" />
    </maxWidth>
  </Label>
  <Label fx:id="relationship" styleClass="cell_small_label" minWidth="0.0">
    <maxWidth>
      <Double fx:constant="MAX_VALUE" />
    </maxWidth>
  </Label>
  <Label fx:id="address" styleClass="cell_small_label" text="\$address">
    <maxWidth>
      <Double fx:constant="MAX_VALUE" />
    </maxWidth>
  </Label>
  <Label fx:id="email" styleClass="cell_small_label" text="\$email">
    <maxWidth>
      <Double fx:constant="MAX_VALUE" />
    </maxWidth>
  </Label>
</VBox>
